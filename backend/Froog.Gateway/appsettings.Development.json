{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "sandbox": {
        "ClusterId": "sandbox-cluster",
        "Match": {
          "Path": "/sandbox/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": {
            "Address": "http://localhost:5103/"
          }
        }
      },
      "sandbox-cluster": {
        "Destinations": {
          "sandbox": {
            "Address": "http://localhost:5041/"
          }
        }
      }
    }
  }
}